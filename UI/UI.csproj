	<Target Name="PostBuildSyncBackend" AfterTargets="Build">
	<PropertyGroup>
		<ApiSrcDir Condition="Exists('$(SolutionDir)Api\bin\x64\$(Configuration)\net10.0\win-x64\')">$(SolutionDir)Api\bin\x64\$(Configuration)\net10.0\win-x64\</ApiSrcDir>
		<ApiSrcDir Condition="'$(ApiSrcDir)' == ''">$(SolutionDir)Api\bin\$(Configuration)\net10.0\win-x64\</ApiSrcDir>
	</PropertyGroup>

	<Message Importance="high" Text="---- [DEBUG] Dang dong bo Backend tu: $(ApiSrcDir) ----" />
	
	<Exec Command="if not exist &quot;$(TargetDir)Backend&quot; mkdir &quot;$(TargetDir)Backend&quot;" />
	<Exec Command="xcopy /y /s /e /i /h /r &quot;$(ApiSrcDir)*&quot; &quot;$(TargetDir)Backend\&quot;" IgnoreExitCode="true" />
	
	<Message Importance="high" Text="---- [DEBUG] Da dong bo Backend vao bin ----" />
</Target>

<Target Name="CopyBackendOnPublish" AfterTargets="Publish">
	<PropertyGroup>
		<ApiSrcDir Condition="Exists('$(SolutionDir)Api\bin\x64\$(Configuration)\net10.0\win-x64\')">$(SolutionDir)Api\bin\x64\$(Configuration)\net10.0\win-x64\</ApiSrcDir>
		<ApiSrcDir Condition="'$(ApiSrcDir)' == ''">$(SolutionDir)Api\bin\$(Configuration)\net10.0\win-x64\</ApiSrcDir>
		<PublishBackendDir>$(PublishDir)Backend\</PublishBackendDir>
	</PropertyGroup>

	<Message Importance="high" Text="---- [PUBLISH] DANG DONG GOI BACKEND TU: $(ApiSrcDir) ----" />
	
	<Exec Command="if not exist &quot;$(PublishBackendDir)&quot; mkdir &quot;$(PublishBackendDir)&quot;" />
	<Exec Command="xcopy /y /s /e /i /h /r &quot;$(ApiSrcDir)*&quot; &quot;$(PublishBackendDir)&quot;" IgnoreExitCode="true" />
	
	<Message Importance="high" Text="---- [PUBLISH] HOAN TAT ----" />
</Target>
